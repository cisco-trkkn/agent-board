diff -ruN ./bin/_tc_bins.zsh ../b/bin/_tc_bins.zsh
--- a/bin/_tc_bins.zsh	2026-11-09 16:00:50
+++ b/bin/_tc_bins.zsh	2026-11-09 16:00:50
@@ -58,6 +58,13 @@
   elif (( $+commands[$1] )); then print -r -- "$commands[$1]"
   else print -r -- "$HOME/.local/bin/$1"; fi
 }
-tc_tmux() { "${TC_TMUX_CMD[@]}" "$@" }
+# new-session is the call that can start the server, and a tmux server keeps the directory it started in for life. Once that
+# directory is removed (a merged worktree), tmux 3.8 starts every new pane there and ignores -c
+# (docs/superpowers/notes/2026-11-09-relay-gone-cwd.md). So new-session always runs from $HOME (/ if that fails); every
+# caller passes -c with an absolute path.
+tc_tmux() {
+  if [[ "$1" == new-session ]]; then ( builtin cd -q -- "$HOME" 2>/dev/null || builtin cd -q /; "${TC_TMUX_CMD[@]}" "$@" )
+  else "${TC_TMUX_CMD[@]}" "$@"; fi
+}
 tc_tmux_args_str() { print -r -- "${(j: :)${(q)TC_TMUX_ARGS[@]}}" }
 tc_tmux_resolve
diff -ruN ./bin/tmux-ctl ../b/bin/tmux-ctl
--- a/bin/tmux-ctl	2026-11-09 16:00:50
+++ b/bin/tmux-ctl	2026-11-09 16:00:50
@@ -425,14 +425,17 @@
     rules=""; wr="$HOME/.config/agent-board/worker.md"; [[ -r "$wr" ]] || wr="$AB_REPO/claude/worker.md"   # a user override wins
     [[ -r "$wr" ]] && rules=" --append-system-prompt-file ${(q)wr}"
     # workers never see the end-of-session CLAUDE.md nudge (it asks an absent user a question)
-    line="CLAUDE_MD_REVISE_HOOK=0 TC_ROLE=worker PATH=${(q)$(ab_path)} AGENT_BOARD_REPO=${(q)AB_REPO} claude --model $model --effort $effort -w ${(q)name} -n ${(q)name} $(ab_claude_args)${rules} ${(q)task}"
+    root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run from inside a git repo (workers get their own worktree)"
+    # cd first: a pane can start somewhere other than its -c directory (a tmux server whose own cwd was removed starts
+    # every pane there, docs/superpowers/notes/2026-11-09-relay-gone-cwd.md); claude then exits at startup or makes its
+    # worktree in the wrong repo
+    line="cd -- ${(q)root} && CLAUDE_MD_REVISE_HOOK=0 TC_ROLE=worker PATH=${(q)$(ab_path)} AGENT_BOARD_REPO=${(q)AB_REPO} claude --model $model --effort $effort -w ${(q)name} -n ${(q)name} $(ab_claude_args)${rules} ${(q)task}"
     # the line is long (task, PATH): typed into a shell that has not started ZLE it overflows the tty's 1024-byte typeahead, so it goes in a file and only `. file` is typed
     launchf="$STATE/agents/${SESSION//[^A-Za-z0-9._-]/_}-$name.zsh"   # a tmux session name can hold other characters
     [[ -n "$TC_AGENT_DRYRUN" ]] && { print -r -- "DRYRUN model: $model effort: $effort"; print -r -- "DRYRUN task: $task"; print -r -- "DRYRUN line: $line"; print -r -- "DRYRUN launch: $launchf"; exit 0 }   # test seam: stop before any window is created
     t list-windows -t "=$SESSION" -F '#{window_name}' | grep -qxF -- "$name" && die "window '$name' already exists"   # before the write: a refused re-launch must not overwrite a running worker's file
     # write the launch file before any window exists: a failed write must not leave an idle window behind
     ( umask 077; mkdir -p "${launchf:h}" && print -r -- "$line" > "$launchf" && chmod 700 "${launchf:h}" && chmod 600 "$launchf" ) || die "cannot write launch file $launchf"
-    root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run from inside a git repo (workers get their own worktree)"
     t new-window -d -t "=$SESSION:" -n "$name" -c "$root"
     t set-option -w -t "$(target "$name")" @tc_agent 1
     t set-option -w -t "$(target "$name")" automatic-rename off
