{
  "env": { "AGENT_BOARD": "1", "TC_ROLE": "overseer" },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read", "Grep", "Glob",
      "mcp__plugin_discord_discord__reply", "mcp__plugin_discord_discord__fetch_messages",
      "Bash(tmux-ctl overview *)",
      "Bash(tmux-ctl discord ideas-list*)", "Bash(tmux-ctl discord ideas-post*)",
      "Bash(git log *)", "Bash(git status *)", "Bash(git show *)"
    ],
    "deny": [
      "Write", "Edit", "MultiEdit", "NotebookEdit", "Agent", "SendMessage", "WebFetch", "WebSearch", "Skill",
      "Bash(tmux-ctl send *)", "Bash(tmux-ctl run *)", "Bash(tmux-ctl tell *)", "Bash(tmux-ctl agent *)",
      "Bash(tmux-ctl keys *)", "Bash(tmux-ctl relay *)", "Bash(tmux-ctl new *)", "Bash(tmux-ctl idea *)", "Bash(tmux-ctl artifact *)", "Bash(tmux-ctl context *)", "Bash(tmux-ctl _*)",
      "Bash(tmux send-keys *)", "Bash(tmux * send-keys *)", "Bash(tmux kill-*)", "Bash(tmux * kill-*)",
      "Bash(git log *--output*)", "Bash(git show *--output*)",
      "Bash(git push *)", "Bash(git commit *)", "Bash(git checkout *)", "Bash(git merge *)", "Bash(git reset *)"
    ]
  },
  "enabledPlugins": { "discord@claude-plugins-official": true },
  "teammateMode": "in-process"
}
