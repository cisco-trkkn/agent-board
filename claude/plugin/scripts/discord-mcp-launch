#!/bin/sh
# discord-mcp-launch <plugin root> — the command the discord plugin's .mcp.json runs (tools/lib/discord-launch.zsh
# installs it). With a bot token it is the real server; without one it is a stub MCP server that connects and offers
# nothing. The real server exits at once without a token, and Claude Code caches that failure for 15 minutes for the
# whole machine, which keeps a lead that starts inside the window from ever connecting Discord.
# Token: DISCORD_BOT_TOKEN in the environment, else a DISCORD_BOT_TOKEN=<non-empty> line in <state dir>/.env, the
# state dir being $DISCORD_STATE_DIR, else ${CLAUDE_CONFIG_DIR:-~/.claude}/channels/discord.
# discord-mcp-launch --has-token <state dir> — exit 0 when <dir>/.env holds a non-empty DISCORD_BOT_TOKEN. The one definition
# of "has a token": bin/claude-orchestrator opts a lead into the channel with it, so a lead never gets --channels for a stub.
has_token() { grep -q '^DISCORD_BOT_TOKEN=.' "$1/.env" 2>/dev/null; }
if [ "$1" = "--has-token" ]; then has_token "$2"; exit $?; fi
root="${1:-${CLAUDE_PLUGIN_ROOT:-.}}"
dir="${DISCORD_STATE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/channels/discord}"
if [ -n "$DISCORD_BOT_TOKEN" ] || has_token "$dir"; then
  # The plugin server runs under node, not bun: this Mac's proxy tunnels bun's Discord gateway connection and keeps
  # dropping its session, while node's is steady. Needs node >= 22.6 (--experimental-strip-types); otherwise, or with
  # TC_DISCORD_RUNTIME=bun, the stock bun start. The dependency install is not a gateway connection and keeps bun;
  # its output goes to stderr so stdout stays clean for MCP stdio, and a failed install is not fatal (node_modules may exist).
  if [ "$TC_DISCORD_RUNTIME" != bun ] && command -v node >/dev/null 2>&1; then
    nv="$(node --version 2>/dev/null)"; nv="${nv#v}"; nmaj="${nv%%.*}"; nmin="${nv#*.}"; nmin="${nmin%%.*}"
    case "$nmaj$nmin" in *[!0-9]*|"") nmaj=0; nmin=0 ;; esac
    if [ "$nmaj" -gt 22 ] || { [ "$nmaj" -eq 22 ] && [ "$nmin" -ge 6 ]; }; then
      cd "$root" || exit 1
      bun install --no-summary >&2 || true
      exec node --experimental-strip-types "$PWD/server.ts"
    fi
  fi
  exec bun run --cwd "$root" --shell=bun --silent start
fi
if command -v node >/dev/null 2>&1; then exec node "$root/discord-mcp-stub.js"; fi
exec bun "$root/discord-mcp-stub.js"
