#!/usr/bin/env python3
"""Claude Code statusLine tap: store each payload per session, print one status line.

Never fails Claude Code: every path exits 0 and prints a line.
"""
import json
import os
import re
import sys
import tempfile
import time

FALLBACK = "agent-board"
SESSION_ID = re.compile(r"[A-Za-z0-9-]+")


def _isolate_path():
    # `#!/usr/bin/env python3` cannot pass -I: drop cwd and the script dir by hand.
    here = os.path.dirname(os.path.realpath(__file__))
    drop = {"", os.getcwd(), os.path.dirname(os.path.abspath(__file__)), here}
    sys.path[:] = [p for p in sys.path if p not in drop]
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(here)), "board"))


def _line(p):
    model = (p.get("model") or {}).get("display_name") or "Claude"
    pct = (p.get("context_window") or {}).get("used_percentage")
    ctx = "–" if pct is None else f"{round(pct)}%"
    out = f"{model} · ctx {ctx}"
    five = ((p.get("rate_limits") or {}).get("five_hour") or {}).get("used_percentage")
    if five is not None:
        out += f" · 5h {round(five)}%"
    return out


def _store(p):
    sid = p.get("session_id")
    if not isinstance(sid, str) or not SESSION_ID.fullmatch(sid):
        return
    import tc_env
    d = tc_env.state_dir() / "statusline"
    d.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump({**p, "received_at": time.time()}, f)
        os.replace(tmp, d / f"{sid}.json")
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    try:
        _isolate_path()
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise ValueError("payload is not an object")
        line = _line(payload)
        try:
            _store(payload)
        except Exception:
            pass
        print(line)
    except Exception:
        print(FALLBACK)


if __name__ == "__main__":
    main()
    sys.exit(0)
