#!/usr/bin/env zsh
# claude-orchestrator — start Claude Code in orchestrator mode: agent team by default,
# aware of the dev session's windows. Used by `dev` for its claude window.
# Extra arguments pass through to claude (e.g. claude-orchestrator --continue).
PROMPT_FILE="$HOME/.claude/orchestrator.md"
# Fixed session name, so the title stays "orchestrator" whatever the task (Claude Code otherwise
# retitles the session per task). Pass your own -n/--name to override.
NAME_ARGS=(--name orchestrator)
(( ${@[(I)-n|--name|--name=*]} )) && NAME_ARGS=()
if [[ -r "$PROMPT_FILE" ]]; then
  exec claude "${NAME_ARGS[@]}" --append-system-prompt-file "$PROMPT_FILE" "$@"
else
  print -u2 "claude-orchestrator: $PROMPT_FILE missing, starting plain claude"
  exec claude "${NAME_ARGS[@]}" "$@"
fi
