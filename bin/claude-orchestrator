#!/usr/bin/env zsh
# claude-orchestrator — start Claude Code in orchestrator mode: agent team by default,
# aware of the dev session's windows. Used by `dev` for its claude window.
# Extra arguments pass through to claude (e.g. claude-orchestrator --continue).
source "${0:A:h}/_ab_claude.zsh"
export PATH="$(ab_path)" AGENT_BOARD_REPO="$AB_REPO"
# the dev-lead marker read by the agent-name-guard hook: this process only, never the tmux session environment, so
# teammates, tmux-ctl agent workers and the overseer do not inherit it
export AGENT_BOARD_LEAD=1
# the Discord channel plugin runs under bun: put it on PATH before the session env below copies PATH
[[ -d "$HOME/.bun/bin" ]] && (( ! ${path[(Ie)$HOME/.bun/bin]} )) && export PATH="$HOME/.bun/bin:$PATH"
# teammates inherit the tmux session environment, not this shell's exports (see the teammate-config-inheritance spec)
if [[ -n "$TMUX" ]]; then
  source "${0:A:h}/_tc_bins.zsh"
  tc_tmux set-environment AGENT_BOARD_REPO "$AB_REPO" 2>/dev/null
  tc_tmux set-environment PATH "$PATH" 2>/dev/null
fi
# --channels is variadic in claude: one list, built here, goes right before AB_ARGS (which starts with --settings and so ends
# the list), never next to the caller's positional prompt. The caller's own entries (tagged plugin:/server:) are taken out of
# "$@" and merged with the automatic one, so two --channels flags never fight over which one wins.
CH=() REST=()
while (( $# )); do
  case "$1" in
    --channels=*) CH+=("${1#--channels=}"); shift ;;
    --channels) shift; while (( $# )) && [[ "$1" == (plugin|server):* ]]; do CH+=("$1"); shift; done ;;
    *) REST+=("$1"); shift ;;
  esac
done
set -- "${REST[@]}"
# Discord channel (spec 2026-11-11 §2): a lead whose project has a saved token ($TC_STATE/discord/<project>/.env) gets the
# channel and its own state dir, unless another live lead already holds that bot. This process only, never the tmux session
# env: teammates must not inherit it.
DC_ADDED=0
unset DISCORD_STATE_DIR TELEGRAM_STATE_DIR
if [[ "${TC_DISCORD-1}" != 0 ]]; then
  if [[ -z "$TMUX" || -z "$TMUX_PANE" ]]; then
    print -u2 "agent-board lead: not in tmux, so no Discord channel"
  else
    DC_PROJECT="$(tc_tmux display -p -t "$TMUX_PANE" '#{?session_group,#{session_group},#{session_name}}' 2>/dev/null)"
    # a -bg session belongs to its project (same rule as tmux-ctl's FEEDKEY)
    [[ -n "$(tc_tmux display -p -t "$TMUX_PANE" '#{@tc_bg}' 2>/dev/null)" ]] && DC_PROJECT="${DC_PROJECT%-bg}"
    DC_DIR="${TC_STATE:-$HOME/.local/state/agent-board}/discord/$DC_PROJECT"
    # the same test the plugin launcher applies (a .env without a token value runs its stub, which has no channel to offer)
    if [[ -n "$DC_PROJECT" ]] && "$AB_REPO/claude/plugin/scripts/discord-mcp-launch" --has-token "$DC_DIR"; then
      # a second lead on the same bot would fight the first over the gateway: only one lead holds it. A holder in this very
      # pane is a stale one (an in-place replacement), so that lead proceeds.
      DC_HOLD="$( { source "$AB_REPO/tools/lib/discord.zsh" && dc_holder "$DC_DIR" } 2>/dev/null )" || DC_HOLD=
      DC_HPANE="${DC_HOLD#* }"
      if [[ -n "$DC_HOLD" && "$DC_HPANE" != "$TMUX_PANE" ]]; then
        DC_WHO=
        [[ "$DC_HPANE" != - ]] && DC_WHO="$(tc_tmux display -p -t "$DC_HPANE" '#{pane_id} #{session_name}:#{window_name}' 2>/dev/null)"
        [[ "${DC_WHO%% *}" == "$DC_HPANE" ]] && DC_WHO="the lead in ${DC_WHO#* }" || DC_WHO="another process"
        print -u2 "discord: $DC_PROJECT's bot is held by $DC_WHO (pid ${DC_HOLD%% *}); this lead starts without it"
      else
        export DISCORD_STATE_DIR="$DC_DIR"
        CH+=(plugin:discord@claude-plugins-official); DC_ADDED=1
      fi
    fi
  fi
fi
CH=("${(@u)CH}")
CH_ARGS=(); (( ${#CH} )) && CH_ARGS=(--channels "${CH[@]}")
# A failed discord start is cached by Claude Code for 15 min, machine-wide: a lead that starts inside the window skips the
# channel for good. Clear that one key before the lead starts; never let it block the launch.
(( DC_ADDED )) && { python3 "$AB_REPO/tools/discord_cache.py" clear || true } >/dev/null 2>&1
# The discord plugin runs in every session, token or not: point it at the launcher that connects a stub when there is
# no token, so a token-less session never records the failure either (tools/lib/discord-launch.zsh). Never blocks the launch.
{ source "$AB_REPO/tools/lib/discord-launch.zsh" && dc_ensure_launcher } || true
AB_ARGS=("${(@Q)${(z)$(ab_claude_args)}}")
PROMPT_FILE="$HOME/.config/agent-board/orchestrator.md"   # a user override wins over the repo's rules
[[ -r "$PROMPT_FILE" ]] || PROMPT_FILE="$AB_REPO/claude/orchestrator.md"
# No default --name: Claude Code titles each lead session from its task, as claude.ai and Desktop do,
# and the board and ListAgents show that title. Pass -n/--name to fix one.
# The lead runs on Opus; frontier teammates get Fable through model routing. Pass --model to override.
MODEL_ARGS=(--model opus)
(( ${@[(I)--model|--model=*]} )) && MODEL_ARGS=()
if [[ -r "$PROMPT_FILE" ]]; then
  exec claude "${MODEL_ARGS[@]}" "${CH_ARGS[@]}" "${AB_ARGS[@]}" --append-system-prompt-file "$PROMPT_FILE" "$@"
else
  print -u2 "claude-orchestrator: $PROMPT_FILE missing, starting plain claude"
  exec claude "${MODEL_ARGS[@]}" "${CH_ARGS[@]}" "${AB_ARGS[@]}" "$@"
fi
