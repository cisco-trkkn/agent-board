#!/usr/bin/env zsh
# claude-orchestrator — start Claude Code in orchestrator mode: agent team by default,
# aware of the dev session's windows. Used by `dev` for its claude window.
# Extra arguments pass through to claude (e.g. claude-orchestrator --continue).
source "${0:A:h}/_ab_claude.zsh"
export PATH="$(ab_path)" AGENT_BOARD_REPO="$AB_REPO"
# the dev-lead marker read by the agent-name-guard hook: this process only, never the tmux session environment, so
# teammates, tmux-ctl agent workers and the overseer do not inherit it
export AGENT_BOARD_LEAD=1
# the Telegram channel plugin runs under bun: put it on PATH before the session env below copies PATH
[[ -d "$HOME/.bun/bin" ]] && (( ! ${path[(Ie)$HOME/.bun/bin]} )) && export PATH="$HOME/.bun/bin:$PATH"
# teammates inherit the tmux session environment, not this shell's exports (see the teammate-config-inheritance spec)
if [[ -n "$TMUX" ]]; then
  source "${0:A:h}/_tc_bins.zsh"
  tc_tmux set-environment AGENT_BOARD_REPO "$AB_REPO" 2>/dev/null
  tc_tmux set-environment PATH "$PATH" 2>/dev/null
fi
# Telegram channel (spec 11): a lead whose project has a saved token ($TC_STATE/telegram/<project>/.env) gets the
# channel flag and its own state dir. This process only, never the tmux session env: teammates must not inherit it.
TG_ARGS=()
unset TELEGRAM_STATE_DIR
if [[ "${TC_TELEGRAM-1}" != 0 && -n "$TMUX" && -n "$TMUX_PANE" ]]; then
  TG_PROJECT="$(tc_tmux display -p -t "$TMUX_PANE" '#{?session_group,#{session_group},#{session_name}}' 2>/dev/null)"
  # a -bg session belongs to its project (same rule as tmux-ctl's FEEDKEY)
  [[ -n "$(tc_tmux display -p -t "$TMUX_PANE" '#{@tc_bg}' 2>/dev/null)" ]] && TG_PROJECT="${TG_PROJECT%-bg}"
  TG_DIR="${TC_STATE:-$HOME/.local/state/agent-board}/telegram/$TG_PROJECT"
  if [[ -n "$TG_PROJECT" && -f "$TG_DIR/.env" ]]; then
    export TELEGRAM_STATE_DIR="$TG_DIR"
    (( ${@[(I)--channels|--channels=*]} )) || TG_ARGS=(--channels plugin:telegram@claude-plugins-official)
  fi
fi
AB_ARGS=("${(@Q)${(z)$(ab_claude_args)}}")
PROMPT_FILE="$HOME/.config/agent-board/orchestrator.md"   # a user override wins over the repo's rules
[[ -r "$PROMPT_FILE" ]] || PROMPT_FILE="$AB_REPO/claude/orchestrator.md"
# No default --name: Claude Code titles each lead session from its task, as claude.ai and Desktop do,
# and the board and ListAgents show that title. Pass -n/--name to fix one.
# The lead runs on Opus; frontier teammates get Fable through model routing. Pass --model to override.
MODEL_ARGS=(--model opus)
(( ${@[(I)--model|--model=*]} )) && MODEL_ARGS=()
if [[ -r "$PROMPT_FILE" ]]; then
  exec claude "${MODEL_ARGS[@]}" "${AB_ARGS[@]}" "${TG_ARGS[@]}" --append-system-prompt-file "$PROMPT_FILE" "$@"
else
  print -u2 "claude-orchestrator: $PROMPT_FILE missing, starting plain claude"
  exec claude "${MODEL_ARGS[@]}" "${AB_ARGS[@]}" "${TG_ARGS[@]}" "$@"
fi
