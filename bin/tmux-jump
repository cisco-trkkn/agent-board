#!/usr/bin/env zsh
# tmux-jump — fuzzy-search every window in every session and jump to it.
# Opened by Ctrl-a f (runs inside a tmux popup).
emulate -L zsh
TMUX_BIN="$HOME/.local/bin/tmux"
FZF_BIN="$HOME/.local/bin/fzf"

pick="$("$TMUX_BIN" list-windows -a -F '#{session_name}:#{window_index}	#{session_name} › #{window_name}  #{?window_bell_flag,🔴 needs you,}	#{pane_current_path}' |
  "$FZF_BIN" --layout=reverse --delimiter='\t' --with-nth=2,3 --tabstop=4 \
    --prompt='jump to › ' --header='type to search · Enter = go · Esc = cancel' \
    --color='bg+:#313244,fg+:#cdd6f4,hl:#f38ba8,hl+:#f38ba8,prompt:#cba6f7,pointer:#f5c2e7,header:#6c7086,border:#cba6f7' \
  | cut -f1)"

client=()
[[ -n "$1" ]] && client=(-c "$1")
[[ -n "$pick" ]] && "$TMUX_BIN" switch-client "${client[@]}" -t "$pick"
