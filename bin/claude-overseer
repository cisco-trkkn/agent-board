#!/usr/bin/env zsh
# claude-overseer — start the read-only overseer Claude: haiku at low effort, its own settings (read-only permissions,
# dontAsk) and rules, no agent-board plugin (its hooks mirror and register for a project; the overseer has none).
# --setting-sources project,local leaves out the user source: ~/.claude/settings.json allows (Bash(tmux-ctl:*)…) must not widen
# the overseer's rules. Extra arguments pass through to claude. Used by tmux-overseer for the `overseer` session's claude window.
source "${0:A:h}/_ab_claude.zsh"
unset CLAUDE_CODE_CHILD_SESSION   # inherited from a Claude-started tmux server it would switch transcripts off in the overseer
unset CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_SSE_PORT CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN   # session-scoped: they belong to the session that started the tmux server, not to the overseer
export PATH="$(ab_path)" AGENT_BOARD_REPO="$AB_REPO" TC_ROLE=overseer CLAUDE_MD_REVISE_HOOK=0
# Ops bot chat (spec 2026-11-12): with a token in <_ops>/.env the overseer also connects the discord channel on the ops bot's state
# dir, so the user can talk to it in #command-center. Without one nothing changes (and a lead's inherited DISCORD_STATE_DIR is dropped).
# The plugin only loads through the enabledPlugins entry in overseer-settings.json (--setting-sources leaves out the user source).
unset DISCORD_STATE_DIR
CH_ARGS=()
OPS_DIR="${TC_STATE:-$HOME/.local/state/agent-board}/discord/_ops"
if [[ "${TC_DISCORD-1}" != 0 ]] && "$AB_REPO/claude/plugin/scripts/discord-mcp-launch" --has-token "$OPS_DIR"; then
  [[ -d "$HOME/.bun/bin" ]] && (( ! ${path[(Ie)$HOME/.bun/bin]} )) && export PATH="$HOME/.bun/bin:$PATH"   # the plugin runs under bun
  export DISCORD_STATE_DIR="$OPS_DIR"
  CH_ARGS=(--channels plugin:discord@claude-plugins-official)
  { python3 "$AB_REPO/tools/discord_cache.py" clear || true } >/dev/null 2>&1   # a cached failed start would skip the channel
fi
# enabledPlugins loads the discord plugin in every overseer: point its .mcp.json at the launcher so a token-less one connects the stub
# and never records a failed start (as claude-orchestrator does; never blocks the launch).
{ source "$AB_REPO/tools/lib/discord-launch.zsh" && dc_ensure_launcher } || true
exec claude --model haiku --effort low "${CH_ARGS[@]}" -n overseer --setting-sources project,local --settings "$AB_REPO/claude/overseer-settings.json" \
  --append-system-prompt-file "$AB_REPO/claude/overseer.md" "$@"
