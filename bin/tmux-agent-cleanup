#!/usr/bin/env zsh
# tmux-agent-cleanup [dir] — pick finished Claude agent worktrees to remove.
# Only touches worktrees under .claude/worktrees/. Never forces:
#   - a worktree with uncommitted changes is kept (git refuses to remove it)
#   - a locked worktree is removed only if its Claude lock is stale (dead or reused pid)
#   - its branch is deleted only if already merged (git branch -d)
emulate -L zsh
FZF_BIN="$HOME/.local/bin/fzf"

dir="${1:-$PWD}"
main_wt="$(git -C "$dir" worktree list --porcelain 2>/dev/null | awk 'NR==1{print $2}')"
if [[ -z "$main_wt" ]]; then
  print "Not inside a git repo: $dir"; read -k1 "?Press any key…"; exit 1
fi
cd "$main_wt"
base="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo main)"
current="$(git branch --show-current)"

rows=()
wt="" br="" lk=""
while IFS= read -r line; do
  case "$line" in
    worktree\ *) wt="${line#worktree }" ;;
    branch\ *)   br="${line#branch refs/heads/}" ;;
    locked*)     lk="${line#locked}"; lk="${lk# }"; [[ -z "$lk" ]] && lk="locked" ;;
    "")
      if [[ "$wt" == */.claude/worktrees/* ]]; then
        state="clean"
        [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]] && state="UNCOMMITTED CHANGES"
        merged="not merged"
        if [[ -n "$br" ]]; then
          if git merge-base --is-ancestor "$br" "$current" 2>/dev/null || git merge-base --is-ancestor "$br" "$base" 2>/dev/null; then
            merged="merged"
          fi
        fi
        age="$(git -C "$wt" log -1 --format=%cr 2>/dev/null)"
        rows+=("$wt	${wt:t}	${br:-detached}	$merged	$state	$age	$lk")
      fi
      wt="" br="" lk="" ;;
  esac
done < <(git worktree list --porcelain; echo)

if (( ${#rows} == 0 )); then
  print "No Claude agent worktrees in $main_wt — nothing to clean up."; read -k1 "?Press any key…"; exit 0
fi

picked=("${(@f)$(print -l -- "${rows[@]}" |
  "$FZF_BIN" --multi --layout=reverse --delimiter='\t' --with-nth=2,4,5,6 --tabstop=2 \
    --prompt='clean up › ' \
    --header=$'Tab = mark · Enter = remove marked · Esc = cancel\n(merged into '"$current"' or '"$base"' are safe to remove)' \
    --color='bg+:#313244,fg+:#cdd6f4,hl:#f38ba8,prompt:#cba6f7,pointer:#f5c2e7,marker:#a6e3a1,header:#6c7086')}")
[[ -z "${picked[1]}" ]] && exit 0

for row in "${picked[@]}"; do
  path_="${row%%	*}"
  branch="$(print -r -- "$row" | cut -f3)"
  print "\n› ${path_:t}"
  lk="$(print -r -- "$row" | cut -f7)"
  if [[ -n "$lk" ]]; then
    if [[ "$lk" =~ '^claude [^ ]+ .+ \(pid ([0-9]+)( start .+)?\)$' ]]; then
      pid="$match[1]"
      if { kill -0 "$pid" 2>&1 | grep -q 'not permitted'; } || { kill -0 "$pid" 2>/dev/null && ps -o args= -p "$pid" | grep -qi claude; }; then
        print "  kept (in use by a running Claude session, pid $pid)"; continue
      fi
      git worktree unlock "$path_" && print "  unlocked stale lock (pid $pid)"
    else
      print "  kept (locked: $lk)"; continue
    fi
  fi
  if err="$(git worktree remove "$path_" 2>&1)"; then
    print "  removed worktree"
    if [[ "$branch" != detached ]]; then
      git branch -d "$branch" >/dev/null 2>&1 && print "  deleted branch $branch" \
        || print "  kept branch $branch (not merged — delete it yourself if you're sure)"
    fi
  else
    [[ -n "$lk" ]] && git worktree lock --reason "$lk" "$path_"
    print "  kept: $err"
  fi
done
git worktree prune
read -k1 "?Done. Press any key…"
