#!/usr/bin/env zsh
# tmux-ctl — let the Claude in a dev session use the other windows of its session.
#
#   tmux-ctl list                          windows: name, command, idle/busy, agent/lane flags
#   tmux-ctl read  <win> [feed|watch] [lines]  last N lines of a window's main pane (default 60),
#                                          or of its feed/watch pane
#   tmux-ctl feed  [win] [lines]           tail of the window's feed log (default both, 80 lines)
#   tmux-ctl run   [-t secs] [-C dir] <win> <cmd>
#                                          type cmd into an IDLE shell window, wait for it,
#                                          print its output, exit with its exit code (default 600s).
#                                          Busy window -> your own lane window <win>·<you>;
#                                          runs in -C dir (default: your git top level)
#                                          the command runs in a subshell: cd/export/source do not persist (use send)
#                                          tests/shell (and lanes) live in the hidden session <project>-bg; runs are recorded for the board's Activity drawer
#   tmux-ctl send  [-C dir] <win> <text>   type text + Enter into an IDLE shell window, don't wait
#   tmux-ctl keys  <win> <key>...          raw keys, e.g. C-c to stop something you started
#   tmux-ctl new   <win> [dir]             open a new shell window
#   tmux-ctl agent <name> [--force] [--model M] [--effort E] <task> | --brief FILE
#                                          start a worker Claude in its own worktree + window.
#                                          --model haiku|sonnet|opus|fable (default sonnet), --effort low|medium|high|xhigh (default medium)
#                                          The brief needs goal, scope, done-criterion: <8 words is
#                                          refused unless --brief FILE (contents sent verbatim) or --force;
#                                          user-config work (~/.claude, hooks, dotfiles...) draws a warning
#   tmux-ctl tell  <agent> <message>       type a message into a worker's prompt
#                                          (refused while the worker is waiting on the user)
#   tmux-ctl agents                        worker status + last lines
#   tmux-ctl artifact <path> [--kind K]    show a file in the board's artifacts panel
#   tmux-ctl idea  <text>                  file an idea for after the plan (never act on it now)
#   tmux-ctl context show|path|add <section> "<entry>"
#                                          the project's shared agent context file (lead curates; sections Map, How to run, Gotchas, Decisions)
#   tmux-ctl context search <words…>       entries of the core and the archive containing every word
#   tmux-ctl context dream <project>|--all [--dry-run] [--force]  the nightly consolidation run (works outside tmux; --dry-run changes nothing)
#   tmux-ctl context dream-report [project]  the last run's record, summary, proposals and contradictions
#   tmux-ctl context dream-file [project]  file the last run's proposals as ideas and observer notes, each once (prints filed <n>)
#   tmux-ctl context dream-revert <project> <run>  put back the core and archive of that run (prints reverted | already reverted | stale: … | unknown)
#   tmux-ctl context dream-schedule install|status|uninstall  the LaunchAgent that runs context dream --all at 03:30 (macOS only; status prints loaded | not loaded first)
#   tmux-ctl awake on [--queue | --pid N] [--lid]|off|status|sleeps <since> [--all]|lid-setup
#                                          hold the Mac awake (caffeinate) while the queue runs (--queue: bound to the tmux server, survives a relay); sleeps lists the real sleep periods since a time (--all: every Sleep/Wake line)
#   tmux-ctl approve <win> show           print the prompt's tool (T:) and its --expect lines (P:); read-only
#   tmux-ctl approve <win> once|deny --expect <text>  answer the permission prompt showing in a window: the one-time Yes, or No
#                                          (never an always/auto-mode row; refuses when there is no prompt or it changed)
#   tmux-ctl dialog <win> show            print the Claude Code dialog showing in a window (or a pane id, %N) as JSON:
#                                          kind, question, options (n, label, permanent), multi, other, lines; read-only
#   tmux-ctl dialog <win> press --expect <lines> (--option <n>... | --text <text>)  answer that dialog with the keys of its kind; refuses
#                                          (exit 1, nothing sent) unless its lines equal --expect on two reads; --option repeats on a multi-select
#   tmux-ctl dialog <win> rows [--n N]    print the last N (default 8) rows above the input box, the rows `type --expect` compares
#   tmux-ctl dialog <win> type --expect <rows> --text <text>  type a reply into an idle prompt; refuses (exit 1, nothing sent) unless
#                                          those rows are unchanged on two reads, the pane is not in copy mode and the input line is empty
#   tmux-ctl wait-gone <name>... [--timeout S]  after shutdown_requests: wait (default 300 s) until every `✦ <name>` window of this
#                                          session is gone; at the timeout kill the ones left (exit 3)
#   tmux-ctl teammates                     this lead's teammates: name, window alive yes/no, busy/idle, last stop HH:MM, first line
#                                          (from the Stop-hook status files plus the `✦` windows); `no teammates` when none
#   tmux-ctl handoff-mark [--clear]        a self-started handoff marks this session as not yet relayed (the Stop guard
#                                          blocks its stops until `relay` runs); --clear removes the mark (handoff skill only)
#   tmux-ctl lead-restart <project> [--resume | --doc <handoff>]
#                                          restart the project's lead pane (claude, else claude-next) with a fresh
#                                          orchestrator: --resume continues its session; else reads --doc or the
#                                          project's newest handoff. Works outside tmux. Needs a started lead (60 s)
#   tmux-ctl relay <doc> [--old-session ID] after this turn, restart the claude window as a fresh
#                                          orchestrator that starts from <doc> (handoff skill only)
#   tmux-ctl overview [project] [--json]   the overseer digest: one line per open project (plan, in-progress
#                                          tasks, needs-you, lead, last run, spend, alerts), or the JSON
#   tmux-ctl discord token|pair|deny|policy|allow|remove|forget|status [--project <name>]  the project's Discord bot (token read from stdin, never printed)
#   tmux-ctl discord ... --ops  the same on the ops bot (state dir _ops); ops-channels <command center id> <approvals id>  its two channels
#   tmux-ctl discord channel <id>|bridge install|start|stop|audit [--since <ISO>] [--project <name>]  the home channel, the bridge process (window discord in <project>-bg) and its audit log
#   tmux-ctl discord merge-request --project <p> --task <id> --spec <s> --branch <b> [--target main] --tests <line> --verdict <text> [--finding <line>]…  post a merge approval (queue integration ask)
#   tmux-ctl discord send [--thread <key>] [<file>…] [-m <text>] [--project <name>]  post up to 10 files; snap [<project>]  post a PNG of the board
#   tmux-ctl discord watch --once|install|status|uninstall  the reconnect watchdog
#   tmux-ctl gauth config <project> [--adc|--no-adc] [--impersonate <sa>] [--account <email>]  set the fixed Google re-auth command (terminal only, file mode 0600)
#   tmux-ctl gauth start|status|close <project>  run it in window gauth-<project> of <project>-bg; the code is typed by the board (/gauth), never by this command
#   tmux-ctl metrics backfill-tasks [--log P]  task lines (tasks.jsonl) for past runs that have none
#   tmux-ctl metrics analyze [--since 7d|30d|ISO] [--json]  trends, flags, coverage over every project -> stats.json
#   tmux-ctl metrics recommend [--since] [--stats P]  three recommendations over stats.json, evidence-checked
#   tmux-ctl metrics weekly [--dry-run [--json]] [--since] [--tasks-log P]  analyze + recommend; post to Discord (or print)
#   tmux-ctl metrics schedule install|status|uninstall  the Monday 09:00 weekly post (launchd)
#   tmux-ctl discover collect|rank <project> [--root <dir>] [--json]  opportunity discovery: candidates; model-ranked items
#   tmux-ctl discover nightly [--project <p>] [--dry-run] [--force]  the nightly run: rank, post to Discord (--dry-run prints)
#   tmux-ctl discover schedule install|status|uninstall  the 07:00 nightly job (launchd)
#   tmux-ctl scout poll | source add <name> --kind <k> --url <u> [--why <t>] | source list|remove|test [<name>]  trend scout: daily poll, sources
#   tmux-ctl scout weekly [--dry-run] [--force] [--retry]  the Sunday pass: evaluate, draft specs, post the digest (--dry-run prints, writes nothing)
#   tmux-ctl scout schedule install|status|uninstall  the two scout LaunchAgents (poll 06:00, weekly Sun 07:00 + Mon retry)
#   tmux-ctl scout approve|reject|revise <id> [--note <text>] | redraft <id> | pack  decide a drafted spec; redraft a revise now; print the context pack
#   tmux-ctl metrics <sub> …                run-log metrics (board/metrics.py)
#
# send/run only type into windows' main pane (the one without @tc_role) at a shell
# prompt. Targets this pane's session (override: TC_SESSION=<name>).
TC_SELF="${0:A}"          # file scope: inside a function $0 is the function name
emulate -L zsh
setopt pipefail
source "${TC_SELF:h:h}/tools/lib/tc-env.zsh"   # tc-env: state dir, shell/prompt patterns (TC_SELF is the real path in the repo)
source "${0:A:h}/_tc_bins.zsh"
STATE="$TC_STATE_DIR"
mkdir -p "$STATE"

die() { print -u2 "tmux-ctl: $*"; exit 2 }
t()   { tc_tmux "$@" }

# wait-gone: drop the names it saw go from the lead's <state>/shutdown-pending/<session id> (same flock as
# claude/plugin/scripts/shutdown-record.sh, rewritten in place under the lock), so a teammate respawned under the same name
# is not blocked by the Stop guard. An emptied file is deleted with its stop-guard counter. Silent; any problem changes nothing.
wg_clear() {
  [[ "$CLAUDE_CODE_SESSION_ID" =~ '^[A-Za-z0-9_-]+$' && -f "$STATE/shutdown-pending/$CLAUDE_CODE_SESSION_ID" ]] || return 0
  python3 -I -c 'import fcntl, os, sys
try:
    state, sid, gone = sys.argv[1], sys.argv[2], set(sys.argv[3:])
    p = os.path.join(state, "shutdown-pending", sid)
    with open(p, "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        left = [n for n in f.read().split("\n") if n and n not in gone]
        if left:
            f.seek(0); f.truncate(); f.write("".join(n + "\n" for n in left))
        else:
            os.unlink(p)
            try: os.unlink(os.path.join(state, "stop-guard", sid))
            except OSError: pass
except BaseException:
    pass' "$STATE" "$CLAUDE_CODE_SESSION_ID" "$@" >/dev/null 2>&1
  return 0
}

[[ -n "$TMUX" || "$1" == discord || ( "$1" == context && "$2" == dream* ) || ( "$1" == gauth && "$2" == config ) || "$1" == lead-restart || "$1" == awake || "$1" == discover || "$1" == scout || ( "$1" == metrics && ( "$2" == schedule || "$2" == weekly ) ) ]] || die "not inside tmux"   # discord, context dream*, gauth config, metrics schedule|weekly, discover, scout, lead-restart and awake work outside tmux (the restore job's launchd run; awake finds the server through tc_tmux)
if [[ -z "$TMUX" ]]; then
  SESSION=; FEEDKEY=
elif [[ -n "$TC_SESSION" ]]; then
  SESSION="$TC_SESSION"
elif [[ -n "$TMUX_PANE" ]]; then
  SESSION="$(t display -p -t "$TMUX_PANE" '#{session_name}')"
else
  SESSION="$(t display -p '#{session_name}')"
fi
# feed logs are keyed by the canonical session: the group (web-attach views are throwaway grouped sessions)
if [[ -n "$TMUX" ]]; then
  FEEDKEY="$(t display -p -t "=$SESSION:" '#{?session_group,#{session_group},#{session_name}}' 2>/dev/null)"; FEEDKEY="${FEEDKEY:-$SESSION}"
  # a -bg pane belongs to its project: never key state under <project>-bg
  [[ -n "$(t show-options -qv -t "=$SESSION:" @tc_bg 2>/dev/null)" ]] && FEEDKEY="${FEEDKEY%-bg}"
fi
warn_web_key() {   # state filed under a browser view's name is invisible to the project's board
  [[ "$FEEDKEY" == _web-* ]] && print -u2 "tmux-ctl: warning: this is a browser view (${FEEDKEY}), not a project — run it from the project's own session or its state is filed under the wrong key"
}
MAIN="$SESSION"
BG="$FEEDKEY-bg"   # hidden session for the agents' tests/shell windows and their lanes (user keeps a plain shell)
is_bg_win() { [[ "${1%%·*}" == (tests|shell) ]] }
ensure_bg() {
  t has-session -t "=$BG" 2>/dev/null && [[ -n "$(t show-options -qv -t "=$BG:" @tc_bg)" ]] && return
  local root; root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
  # new-session is the atomic gate: only the caller that creates the session finishes setting it up
  if t new-session -d -s "$BG" -n tests -x 200 -y 50 -c "$root" 2>/dev/null; then
    t new-window -d -t "=$BG:" -n shell -c "$root"
    t set-option -t "=$BG:" @tc_bg 1      # set last: it marks the session as complete
    BG_FRESH=1                            # these panes were created in this very call: pick_win waits for their shells
  else
    local n=0; while [[ -z "$(t show-options -qv -t "=$BG:" @tc_bg)" ]] && (( n++ < 40 )); do sleep 0.1; done
  fi
}
# use_win <win>: point $SESSION at the session that holds <win>
use_win() { if is_bg_win "$1"; then ensure_bg; SESSION="$BG"; else SESSION="$MAIN"; fi }
# lock_win <win>: one typist per window at a time (idle check + two-step send-keys must not interleave)
lock_win() {
  local d="$STATE/lock-${FEEDKEY}-${1//\//_}" n=0 owner
  until mkdir "$d" 2>/dev/null; do
    owner="$(<"$d/pid" 2>/dev/null)"
    if [[ -n "$owner" ]] && ! kill -0 "$owner" 2>/dev/null; then rm -rf "$d"; continue; fi   # stale
    (( n++ >= 300 )) && { rm -rf "$d"; continue }    # 30s: never wedge forever
    sleep 0.1
  done
  print -r -- "$$" > "$d/pid"
  LOCKD="$d"      # set only once WE hold it, so a killed waiter never removes someone else's lock
}
# settle_win <pane> <run-id> <base>: after Enter, return as soon as the line has started: rc written,
# pane busy, or history_size+cursor_y moved past <base> (the newline was consumed). Capped at ~1s.
settle_win() {
  local n=0 hs cy
  while (( n++ < 10 )); do
    [[ -n "$2" && -f "$STATE/$2.rc" ]] && return
    pane_idle "$1" || return
    hs="$(t display -p -t "$1" '#{history_size}')"; cy="$(t display -p -t "$1" '#{cursor_y}')"
    (( ${hs:-0} + ${cy:-0} > ${3:-0} )) && return
    sleep 0.1
  done
}
unlock_win() { [[ -n "$LOCKD" && "$(<"$LOCKD/pid" 2>/dev/null)" == "$$" ]] && rm -rf "$LOCKD"; LOCKD= }
main_pane() { t list-panes -t "=$SESSION:$1" -F '#{pane_id} #{@tc_role}' 2>/dev/null | awk '$2==""{print $1; exit}' }
role_pane() { t list-panes -t "=$SESSION:$1" -F '#{pane_id} #{@tc_role}' 2>/dev/null | awk -v r="$2" '$2==r{print $1; exit}' }
target() { local p; p="$(main_pane "$1")"; print -r -- "${p:-=$SESSION:$1}" }
# pane_idle <pane>: at a prompt — the foreground command is a shell AND that shell has no child.
# `zsh script.zsh` shows as "zsh" in #{pane_current_command}, but it runs as a child of the pane's shell.
pane_idle() {
  local cmd pid
  IFS='|' read -r cmd pid <<< "$(t display -p -t "$1" '#{pane_current_command}|#{pane_pid}')"
  [[ "$cmd" == ${~TC_SHELLS} ]] && ! pgrep -P "$pid" >/dev/null 2>&1
}

exists() {
  t list-windows -t "=$SESSION" -F '#{window_name}' | grep -qxF -- "$1" ||
    die "no window '$1' in session '$SESSION' (try: tmux-ctl list)"
}
is_idle() { pane_idle "$(target "$1")" }
need_idle() {
  is_idle "$1" || die "window '$1' is busy running '$(t display -p -t "$(target "$1")" '#{pane_current_command}')' — read it, wait, or ask the user"
}
is_agent() { [[ "$(t show-options -wqv -t "$(target "$1")" @tc_agent)" == 1 ]] }
trim() { sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' }

zmodload zsh/datetime
# summarize <logfile>: "42 passed, 1 failed" (pytest-style) or "ALL PASS"/"N FAILED" (tmux-tools runners)
summarize() {
  local s ran res
  s="$(grep -oE '[0-9]+ (passed|failed|errors?|skipped)' "$1" | tail -4 | paste -sd, - | sed 's/,/, /g')"
  if [[ -z "$s" ]]; then   # unittest: "Ran N tests in …" then "OK" / "FAILED (failures=F, errors=E)"
    ran="$(grep -oE '^Ran [0-9]+ tests?' "$1" | tail -1)"; ran="${ran#Ran }"
    res="$(grep -E '^(OK|FAILED \()' "$1" | tail -1)"
    [[ -n "$ran" && -n "$res" ]] && s="$ran, $res"
  fi
  local z; z="$(grep -oE '^(ALL PASS|[0-9]+ FAILED)$' "$1" | tail -1)"
  [[ -n "$z" ]] && { [[ -z "$s" || "$z" != "ALL PASS" ]] && s="$z"; }   # a zsh suite's FAILED line must not hide behind an earlier OK
  print -r -- "$s"
}
# lock_file <dir>: mkdir lock with stale-owner reclaim, same style as lock_win; sets RLOCKD once held
lock_file() {
  local d="$1" n=0 owner
  until mkdir "$d" 2>/dev/null; do
    owner="$(<"$d/pid" 2>/dev/null)"
    if [[ -n "$owner" ]] && ! kill -0 "$owner" 2>/dev/null; then rm -rf "$d"; continue; fi
    (( n++ >= 300 )) && { rm -rf "$d"; continue }
    sleep 0.1
  done
  print -r -- "$$" > "$d/pid"; RLOCKD="$d"
}
# run_record <exit|null> <duration> <summary>: append one record for the current run
run_record() {
  local f="$STATE/runs-$FEEDKEY.jsonl" rec
  rec="$(jq -nc --arg id "$id" --argjson ts "$t0" --arg agent "$(caller)" --arg win "$win" --arg session "$SESSION" \
    --arg cmd "$cmdtext" --arg cwd "$cdir" --argjson exit "$1" --argjson duration "$2" --arg log "$logf" --arg summary "$3" \
    '{id:$id,ts:$ts,agent:$agent,win:$win,session:$session,cmd:$cmd,cwd:$cwd,exit:$exit,duration:$duration,log:$log,summary:$summary}')" || return
  append_capped "$f" "$rec"
}
# append_capped <file> <json>: locked append, then keep the newest 500 records
append_capped() {
  local f="$1"
  lock_file "$f.lock"
  print -r -- "$2" >> "$f"
  # bounded: keep the newest 500 records (atomic rewrite, under the lock so no append is lost)
  if (( $(wc -l < "$f") > 500 )); then
    rm -f -- "$f".tmp.*(N)      # leftovers of a killed trim
    tail -n 500 "$f" > "$f.tmp.$$" && mv "$f.tmp.$$" "$f"
  fi
  rm -rf "$RLOCKD"; RLOCKD=
}
caller() {
  local pw=""; [[ -n "$TMUX_PANE" ]] && pw="$(t display -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null)"
  pw="${pw#✦ }"; print -r -- "${pw:-claude}"
}
# pick_win: sets $win to the window to type into — <win> if its main pane is idle, else the caller's lane
pick_win() {
  local base="$1" lane
  # a pane created in this call has no prompt yet (its shell is still starting, worse under load): give it up to 3 s
  # before calling it busy. Panes that already existed get no wait: a busy one goes to a lane at once.
  if [[ -n "$BG_FRESH" ]]; then
    local n=0; while ! is_idle "$base" && (( n++ < 60 )); do sleep 0.05; done
    BG_FRESH=
  fi
  if is_idle "$base"; then win="$base"; return; fi
  lane="$base·$(caller)"
  if ! t list-windows -t "=$SESSION" -F '#{window_name}' | grep -qxF -- "$lane"; then
    t new-window -d -t "=$SESSION:" -n "$lane" -c "$(t display -p -t "$(target "$base")" '#{pane_current_path}')"
    t set-option -w -t "=$SESSION:$lane" @tc_lane 1
    t set-option -w -t "=$SESSION:$lane" automatic-rename off
  fi
  need_idle "$lane"
  t set-option -w -t "=$SESSION:$lane" @tc_lane_used "$EPOCHSECONDS"
  print -u2 "tmux-ctl: '$base' is busy — using lane $lane"
  win="$lane"
}
reap_lanes() {
  local name used
  for name in ${(f)"$(t list-windows -t "=$SESSION" -F '#{?#{==:#{@tc_lane},1},#{window_name},}' 2>/dev/null)"}; do
    [[ -z "$name" ]] && continue
    is_idle "$name" || continue
    used="$(t show-options -wqv -t "=$SESSION:$name" @tc_lane_used)"
    [[ -n "$used" ]] || continue
    (( EPOCHSECONDS - used > 900 )) && t kill-window -t "=$SESSION:$name"
  done
}
# reap_cmds: command files of runs that timed out or were interrupted, older than a day
reap_cmds() { find "$STATE/cmds" -type f -mmin +1440 -delete 2>/dev/null }
# parse_opts: consumes -t secs / -C dir (any order) from "$@" into $timeout, $cdir, leaves rest in $rest
parse_opts() {
  local k
  timeout=600; cdir=""; rest=()
  while [[ "$1" == (-t|-C) ]]; do
    [[ -n "$2" ]] || die "option $1 needs a value"
    k="$1"; if [[ "$k" == -t ]]; then timeout="$2"; else cdir="$2"; fi; shift 2
  done
  rest=("$@")
  if [[ -z "$cdir" ]]; then cdir="$(git rev-parse --show-toplevel 2>/dev/null)" || cdir="$PWD"; fi
}
# wrap_cd <win> <cmd>: runs in $cdir via a subshell when that differs from the pane's cwd
wrap_cd() {
  local pp; pp="$(t display -p -t "$(target "$1")" '#{pane_current_path}')"
  if [[ "${cdir:A}" != "${pp:A}" ]]; then print -r -- "( cd ${(q)cdir} || exit 2; $2 )"; else print -r -- "$2"; fi
}

# long_line <id> <line>: prints what to type for <line>. Over 900 bytes (macOS keeps only 1024 bytes of typeahead before
# a fresh shell's ZLE starts, the rest is dropped) it goes to a private file that the pane sources instead.
# A run that times out or is interrupted may leave the file behind: it lives in the private state dir.
long_line() {
  local lid="$1" line="$2" n f
  n="$(print -rn -- "$line" | LC_ALL=C wc -c)"
  if (( n <= 900 )); then print -r -- "$line"; return; fi
  f="$STATE/cmds/$lid.zsh"
  ( umask 077; mkdir -p "${f:h}" && print -r -- "$line" > "$f" && chmod 700 "${f:h}" && chmod 600 "$f" ) || die "cannot write command file $f"
  print -r -- ". ${(q)f}; rm -f -- ${(q)f}"
}

cmd="$1"; shift 2>/dev/null
if [[ "$cmd" == discord ]]; then   # no tmux needed
  source "${0:A:h:h}/tools/lib/discord.zsh"
  discord_cmd "$@"; exit $?
fi
if [[ "$cmd" == gauth ]]; then   # config needs no tmux; the others reach tmux through board/gauth.py
  [[ "$1" == (config|start|status|close) && -n "$2" ]] || die 'usage: tmux-ctl gauth config <project> [--adc|--no-adc] [--impersonate <sa>] [--account <email>] | start|status|close <project>'
  python3 -I "${0:A:h:h}/board/gauth.py" "$@"; exit $?
fi
if [[ "$cmd" == discover ]]; then   # no tmux needed (launchd runs it)
  if [[ "$1" == schedule ]]; then
    [[ "$2" == (install|status|uninstall) ]] || die 'usage: tmux-ctl discover schedule install|status|uninstall'
    exec python3 -I "${0:A:h:h}/board/discover_schedule.py" "$2"
  fi
  exec python3 -I "${0:A:h:h}/board/discover.py" "$@"
fi
if [[ "$cmd" == scout ]]; then   # no tmux needed (launchd runs it)
  if [[ "$1" == schedule ]]; then
    [[ "$2" == (install|status|uninstall) ]] || die 'usage: tmux-ctl scout schedule install|status|uninstall'
    exec python3 -I "${0:A:h:h}/board/scout_schedule.py" "$2"
  fi
  exec python3 -I "${0:A:h:h}/board/scout.py" "$@"
fi
if [[ "$cmd" == metrics && ( "$1" == schedule || "$1" == weekly ) ]]; then   # no tmux needed (launchd runs it)
  if [[ "$1" == schedule ]]; then
    [[ "$2" == (install|status|uninstall) ]] || die 'usage: tmux-ctl metrics schedule install|status|uninstall'
    exec python3 -I "${0:A:h:h}/board/analytics_schedule.py" "$2"
  fi
  exec python3 -I "${0:A:h:h}/board/metrics.py" "$@"
fi
if [[ "$cmd" == context && ( "$1" == dream || "$1" == dream-report || "$1" == dream-file || "$1" == dream-revert || "$1" == dream-schedule ) ]]; then   # no tmux needed (launchd runs it)
  dsub="$1"; shift
  if [[ "$dsub" == dream-schedule ]]; then
    [[ "$1" == (install|status|uninstall) ]] || die 'usage: tmux-ctl context dream-schedule install|status|uninstall'
    python3 -I "${0:A:h:h}/board/dream_schedule.py" "$1"; exit $?
  fi
  if [[ "$dsub" == dream-file ]]; then
    [[ -n "${1:-$FEEDKEY}" ]] || die 'usage: tmux-ctl context dream-file [project]'
    python3 -I "${0:A:h:h}/board/dream.py" file "${1:-$FEEDKEY}"; exit $?
  fi
  if [[ "$dsub" == dream-revert ]]; then
    [[ -n "$1" && -n "$2" ]] || die 'usage: tmux-ctl context dream-revert <project> <run>'
    python3 -I "${0:A:h:h}/board/dream.py" revert "$1" "$2"; exit $?
  fi
  if [[ "$dsub" == dream ]]; then
    [[ -n "$1" ]] || die 'usage: tmux-ctl context dream <project>|--all [--dry-run] [--force]'
    python3 -I "${0:A:h:h}/board/dream.py" run "$@"; exit $?
  fi
  [[ -n "${1:-$FEEDKEY}" ]] || die 'usage: tmux-ctl context dream-report [project]'
  python3 -I "${0:A:h:h}/board/dream.py" report "${1:-$FEEDKEY}"; exit $?
fi
# _done runs when a lane's command ends (the lane looks idle then); help needs no tmux
if [[ "$cmd" != (_done|_append|help|-h|--help|"") ]]; then
  for SESSION in "$MAIN" "$BG"; do t has-session -t "=$SESSION" 2>/dev/null && reap_lanes; done
  reap_cmds
  SESSION="$MAIN"
fi
case "$cmd" in
  list)
    list_session() {
    for name in ${(f)"$(t list-windows -t "=$SESSION" -F '#{window_name}')"}; do
      IFS='|' read -r idx bell agent lane <<< "$(t display -p -t "=$SESSION:$name" '#{window_index}|#{window_bell_flag}|#{@tc_agent}|#{@tc_lane}')"
      mp="$(main_pane "$name")"
      IFS='|' read -r pcmd dir <<< "$(t display -p -t "${mp:-=$SESSION:$name}" '#{pane_current_command}|#{pane_current_path}')"
      state=busy; pane_idle "${mp:-=$SESSION:$name}" && state=idle
      [[ "$bell" == 1 ]] && state="$state,needs-user"
      lanetag=; [[ "$lane" == 1 ]] && lanetag="  (lane)"
      print -r -- "$idx  $name  [$state]  cmd=$pcmd${agent:+  (worker agent)}$lanetag  $dir"
    done
    }
    list_session
    if t has-session -t "=$BG" 2>/dev/null; then
      SESSION="$BG"; list_session | sed 's/$/  (bg)/'; SESSION="$MAIN"
    fi ;;

  teammates)
    source "${0:A:h:h}/tools/lib/teammates.zsh"
    tm_list ;;

  read)
    [[ -n "$1" ]] || die "usage: tmux-ctl read <win> [feed|watch] [lines]"
    win="$1"; shift; use_win "$win"; exists "$win"
    pane="$(target "$win")"
    if [[ "$1" == (feed|watch) ]]; then
      pane="$(role_pane "$win" "$1")"; [[ -n "$pane" ]] || die "window '$win' has no $1 pane"
      shift
    fi
    t capture-pane -p -J -t "$pane" -S "-${1:-60}" | trim ;;

  feed)
    n="${2:-80}"
    if [[ -n "$1" ]]; then
      f="$STATE/feed-$FEEDKEY-$1.log"; if [[ -f "$f" ]]; then tail -n "$n" "$f"; fi
    else
      for w in tests shell; do
        print -r -- "── $w ──"; if [[ -f "$STATE/feed-$FEEDKEY-$w.log" ]]; then tail -n "$n" "$STATE/feed-$FEEDKEY-$w.log"; fi
      done
    fi ;;

  run)
    parse_opts "$@"; set -- "${rest[@]}"
    win="$1"; shift
    [[ "$1" == (-t|-C) ]] && die "options go before the window: tmux-ctl run [-t secs] [-C dir] <win> <cmd>"
    [[ -n "$win" && -n "$*" ]] || die "usage: tmux-ctl run [-t secs] [-C dir] <win> <cmd>"
    use_win "$win"; exists "$win"
    trap 'unlock_win; exit 143' INT TERM HUP; trap unlock_win EXIT
    lock_win "$win"; pick_win "$win"
    id="$$-$RANDOM"; rm -f "$STATE/$id.rc"
    # before the start record: a failed write must not leave a record that never finishes
    typed="$(long_line "$id" "printf '@@TC%s\\n' START-$id; ( set -o pipefail; $(wrap_cd "$win" "$*") ) ; ${(q)TC_SELF} _done $id \$? ; printf '@@TC%s\\n' END-$id")" || exit 2
    cmdtext="$*"; t0=$EPOCHSECONDS; logf="$STATE/logs/$FEEDKEY/$id.log"; mkdir -p "${logf:h}"
    # in place before the start record, so a TERM landing right after (or during) it still finalises the record;
    # it drops the record lock first: the TERM may have hit inside append_capped, which would otherwise wait on its own lock
    trap 'unlock_win; [[ -n "$RLOCKD" ]] && { rm -rf "$RLOCKD"; RLOCKD=; }; run_record 143 $(( EPOCHSECONDS - t0 )) "interrupted"; exit 143' INT TERM HUP   # replaced below once there is a pane to capture
    run_record null 0 ""
    tgt="$(target "$win")"
    hs="$(t display -p -t "$tgt" '#{history_size}')"; cy="$(t display -p -t "$tgt" '#{cursor_y}')"
    start=$(( ${${hs:-0}//[^0-9]/} + ${${cy:-0}//[^0-9]/} ))
    # what the run printed so far, saved so an interrupted or timed-out run still has a log
    savelog() {
      local h; h="$(t display -p -t "$tgt" '#{history_size}' 2>/dev/null)"; h="${${h:-0}//[^0-9]/}"
      t capture-pane -p -J -t "$tgt" -S $(( start - h )) 2>/dev/null | awk -v m="@@TCSTART-$id" 'f{print} $0==m{f=1}' | trim > "$logf"
      : > "$STATE/$id.gone"      # _done sees this and drops the late exit code instead of leaving an .rc behind
    }
    trap 'unlock_win; savelog; run_record 143 $(( EPOCHSECONDS - t0 )) "interrupted"; exit 143' INT TERM HUP
    # the typed line prints a start marker (split in the source so the echo of the line can't match it)
    t send-keys -t "$tgt" -l -- "$typed"
    t send-keys -t "$tgt" Enter
    settle_win "$tgt" "$id" "$start"; unlock_win
    ticks=0
    while [[ ! -f "$STATE/$id.rc" ]]; do
      sleep 0.5
      (( ++ticks > timeout * 2 )) && { savelog; run_record 124 $(( EPOCHSECONDS - t0 )) "timeout"; print -u2 "tmux-ctl: still running after ${timeout}s — check: tmux-ctl read $win"; exit 124; }
    done
    rm -f "$STATE/$id.gone"
    rc="$(<"$STATE/$id.rc")"; rm -f "$STATE/$id.rc"
    [[ "$rc" == <-> ]] || rc=1      # never feed a garbled exit code to jq/exit
    [[ "$win" != "${win%·*}" ]] && t set-option -w -t "=$SESSION:$win" @tc_lane_used "$EPOCHSECONDS" 2>/dev/null
    hist="$(t display -p -t "$tgt" '#{history_size}')"; hist="${${hist:-0}//[^0-9]/}"
    grab() { t capture-pane -p -J -t "$tgt" -S $(( start - hist )) | awk -v m="@@TCSTART-$id" 'f{print} $0==m{f=1}' }
    n=0; raw="$(grab)"
    while [[ "$raw" != *"@@TCEND-$id"* ]] && (( n++ < 30 )); do   # the end marker may still be drawing: wait up to 3s
      sleep 0.1; hist="$(t display -p -t "$tgt" '#{history_size}')"; hist="${${hist:-0}//[^0-9]/}"; raw="$(grab)"
    done
    if [[ "$raw" == *"@@TCEND-$id"* ]]; then   # cut at the end marker; keep text the command left before it on the same line
      out="$(print -r -- "$raw" | awk -v e="@@TCEND-$id" '{i=index($0,e); if(i){if(i>1) print substr($0,1,i-1); exit} print}' | trim)"
    else
      out="$(print -r -- "$raw" | trim | sed '$d')"   # no end marker within 3s: old behaviour (last line = the prompt again)
    fi
    print -r -- "$out" > "$logf"
    run_record "$rc" $(( EPOCHSECONDS - t0 )) "$(summarize "$logf")"
    trap - INT TERM HUP     # only now: the final record is written
    print -r -- "$out"
    print -r -- "[exit $rc]"
    exit "$rc" ;;

  _relay_failed)   # detached relay failed: tell the user, keep the doc
    reason="$(grep -m1 '^relay failed: ' "$1" 2>/dev/null)"   # relay.py's own failure line; its 'relay: attempt N' lines come first
    [[ -n "$reason" ]] || reason="$(grep -m1 . "$1" 2>/dev/null)"
    first="${reason#relay failed: }"
    manual="$(grep -m1 '^manual: ' "$1" 2>/dev/null)"; manual="${manual#manual: }"   # relay.py's line: cd -- <root> && <launcher> '<prompt>'
    [[ -n "$manual" ]] || manual="${(q)TC_REPO}/bin/claude-orchestrator 'Read $2 and continue from where the previous session left off.'"
    msg="relay failed: ${first:-no output} — doc kept at $2; manual: $manual (log: $1)"
    print -r -- "$msg" > "$STATE/relay-failed-${3:-$FEEDKEY}.txt"
    for c in ${(f)"$(t list-clients -F '#{client_name}' 2>/dev/null)"}; do t display-message -c "$c" -d 0 -- "${${msg//\#/##}//\%/%%}"; done ;;

  _append)   # test seam: tmux-ctl _append <file> <json>
    append_capped "$1" "$2" ;;

  _done)   # called by the target shell when a `run` command finishes
    [[ -e "$STATE/$1.gone" ]] && { rm -f "$STATE/$1.gone"; exit 0 }   # the run gave up (timeout/interrupt): nobody will read this
    print -r -- "$2" > "$STATE/$1.rc.tmp.$$" && mv "$STATE/$1.rc.tmp.$$" "$STATE/$1.rc" ;;   # atomic: run never reads a half-written file

  send)
    parse_opts "$@"; set -- "${rest[@]}"
    win="$1"; shift
    [[ "$1" == (-t|-C) ]] && die "options go before the window: tmux-ctl send [-t secs] [-C dir] <win> <cmd>"
    [[ -n "$win" && -n "$*" ]] || die "usage: tmux-ctl send [-C dir] <win> <text>"
    use_win "$win"; exists "$win"
    trap 'unlock_win; exit 143' INT TERM HUP; trap unlock_win EXIT
    lock_win "$win"; pick_win "$win"
    stgt="$(target "$win")"
    shs="$(t display -p -t "$stgt" '#{history_size}')"; scy="$(t display -p -t "$stgt" '#{cursor_y}')"
    sbase=$(( ${${shs:-0}//[^0-9]/} + ${${scy:-0}//[^0-9]/} ))
    typed="$(long_line "send-$$-$RANDOM" "$(wrap_cd "$win" "$*")")" || exit 2
    t send-keys -t "$stgt" -l -- "$typed"
    t send-keys -t "$stgt" Enter
    settle_win "$stgt" "" "$sbase"; unlock_win ;;

  keys)
    win="$1"; shift
    [[ -n "$win" && -n "$*" ]] || die "usage: tmux-ctl keys <win> <key>..."
    use_win "$win"; exists "$win"
    is_agent "$win" && die "'$win' is a worker agent — use 'tmux-ctl tell', and leave its prompts to the user"
    t send-keys -t "$(target "$win")" "$@" ;;

  approve)   # works on worker windows too (unlike keys): only the one-time Yes / No, by digit
    source "${0:A:h:h}/tools/lib/approve.zsh"
    approve_cmd "$@"; exit $? ;;

  dialog)    # any Claude Code dialog, read from the pane text; <win> may be a pane id anywhere on the server
    source "${0:A:h:h}/tools/lib/dialog.zsh"
    dialog_cmd "$@"; exit $? ;;

  new)
    [[ -n "$1" ]] || die "usage: tmux-ctl new <win> [dir]"
    t new-window -d -t "=$SESSION:" -n "$1" -c "${2:-$PWD}" ;;

  agent)
    name="$1"; shift
    force=0; briefile=""; model="$TC_DEFAULT_MODEL"; effort="$TC_DEFAULT_EFFORT"
    while [[ "$1" == --* ]]; do
      case "$1" in
        --force) force=1; shift ;;
        --brief) [[ -n "$2" ]] || die "usage: tmux-ctl agent <name> [--force] (--brief FILE | <task>)"
                 briefile="$2"; shift 2 ;;
        --model)  (( ${TC_MODELS[(Ie)$2]} )) || die "--model needs one of: ${TC_MODELS}"
                  model="$2"; shift 2 ;;
        --effort) (( ${TC_EFFORTS[(Ie)$2]} )) || die "--effort needs one of: ${TC_EFFORTS}"
                  effort="$2"; shift 2 ;;
        *) die "unknown agent option '$1' (tmux-ctl help)" ;;
      esac
    done
    [[ -n "$name" && ( -n "$briefile" || $# -gt 0 ) ]] || die "usage: tmux-ctl agent <name> [--force] (--brief FILE | <task>)"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "usage: tmux-ctl agent <name> ...: the name starts with a letter or digit and holds only letters, digits, . _ -"
    if [[ -n "$briefile" ]]; then
      [[ -z "$*" ]] || die "give either --brief FILE or a task on the command line, not both"
      [[ -r "$briefile" ]] || die "no readable brief file '$briefile'"
      task="$(<"$briefile")"     # verbatim contents are the task; no length check
      [[ -n "${task//[[:space:]]/}" ]] || die "brief file '$briefile' is empty"
    else
      task="$*"
      if (( ! force )) && (( ${#${=task}} < 8 )); then
        print -u2 "tmux-ctl: refusing a ${#${=task}}-word brief — a worker starts with none of your context. Give it goal, scope and a done-criterion, e.g.:
  Goal: add retry with backoff to the GCS upload in src/upload.py.
  Scope: only src/upload.py and tests/test_upload.py; do not touch the CLI.
  Done: 'pytest tests/test_upload.py' passes and a failed upload is retried 3 times.
Write a longer brief inline, pass it as --brief FILE, or use --force to send this one as is."
        exit 2
      fi
    fi
    # user-scope work does not belong in a repo worktree worker (non-fatal)
    if (( ! force )) && print -r -- "$task" | grep -qiE '~/\.claude|\.claude/(settings|skills|hooks|plugins)|settings(\.local)?\.json|global CLAUDE\.md|(^|[^[:alnum:]_])(hooks?|plugins?|skills?|dotfiles?|launchd|launchagents?)([^[:alnum:]_]|$)'; then
      print -u2 "tmux-ctl: warning: this looks like user-config work (~/.claude, settings, hooks, plugins, skills, global CLAUDE.md, LaunchAgents, dotfiles) — run it in the main session, not a worktree worker (--force silences this)"
    fi
    source "${0:A:h}/_ab_claude.zsh"
    rules=""; wr="$HOME/.config/agent-board/worker.md"; [[ -r "$wr" ]] || wr="$AB_REPO/claude/worker.md"   # a user override wins
    [[ -r "$wr" ]] && rules=" --append-system-prompt-file ${(q)wr}"
    # workers never see the end-of-session CLAUDE.md nudge (it asks an absent user a question)
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run from inside a git repo (workers get their own worktree)"
    # cd first: a pane can start somewhere other than its -c directory (a tmux server whose own cwd was removed starts
    # every pane there, docs/superpowers/notes/2026-11-09-relay-gone-cwd.md); claude then exits at startup or makes its
    # worktree in the wrong repo
    line="cd -- ${(q)root} && CLAUDE_MD_REVISE_HOOK=0 TC_ROLE=worker PATH=${(q)$(ab_path)} AGENT_BOARD_REPO=${(q)AB_REPO} claude --model $model --effort $effort -w ${(q)name} -n ${(q)name} $(ab_claude_args)${rules} ${(q)task}"
    # the line is long (task, PATH): typed into a shell that has not started ZLE it overflows the tty's 1024-byte typeahead, so it goes in a file and only `. file` is typed
    launchf="$STATE/agents/${SESSION//[^A-Za-z0-9._-]/_}-$name.zsh"   # a tmux session name can hold other characters
    [[ -n "$TC_AGENT_DRYRUN" ]] && { print -r -- "DRYRUN model: $model effort: $effort"; print -r -- "DRYRUN task: $task"; print -r -- "DRYRUN line: $line"; print -r -- "DRYRUN launch: $launchf"; exit 0 }   # test seam: stop before any window is created
    t list-windows -t "=$SESSION" -F '#{window_name}' | grep -qxF -- "$name" && die "window '$name' already exists"   # before the write: a refused re-launch must not overwrite a running worker's file
    # write the launch file before any window exists: a failed write must not leave an idle window behind
    ( umask 077; mkdir -p "${launchf:h}" && print -r -- "$line" > "$launchf" && chmod 700 "${launchf:h}" && chmod 600 "$launchf" ) || die "cannot write launch file $launchf"
    t new-window -d -t "=$SESSION:" -n "$name" -c "$root"
    t set-option -w -t "$(target "$name")" @tc_agent 1
    t set-option -w -t "$(target "$name")" automatic-rename off
    # worker rules (superpowers skills, decide instead of asking) ride along as a system prompt (built above in $line)
    t send-keys -t "$(target "$name")" -l -- ". ${(q)launchf}"
    t send-keys -t "$(target "$name")" Enter
    print -r -- "started worker '$name' in window $SESSION:$name (worktree .claude/worktrees/$name)" ;;

  tell)
    name="$1"; shift
    [[ -n "$name" && -n "$*" ]] || die "usage: tmux-ctl tell <agent> <message>"
    exists "$name"
    is_agent "$name" || die "'$name' is not a worker agent window"
    is_idle "$name" && die "worker '$name' has exited (window is back at a shell prompt) — read it, or start a new one"
    [[ "$(t display -p -t "$(target "$name")" '#{window_bell_flag}')" == 1 ]] &&
      die "'$name' is waiting on the user (permission prompt or question) — tell the user, don't answer it"
    t capture-pane -p -J -t "$(target "$name")" -S -25 |
      grep -qiE -- "$TC_PROMPT_RE" &&
      die "'$name' is showing a prompt for the user — tell the user, don't answer it"
    t send-keys -t "$(target "$name")" -l -- "$*"
    sleep 0.2
    t send-keys -t "$(target "$name")" Enter ;;

  agents)
    found=0
    for name in ${(f)"$(t list-windows -t "=$SESSION" -F '#{?#{==:#{@tc_agent},1},#{window_name},}')"}; do
      [[ -z "$name" ]] && continue; found=1
      state=working
      [[ "$(t display -p -t "$(target "$name")" '#{window_bell_flag}')" == 1 ]] && state="WAITING ON USER"
      is_idle "$name" && state="exited (back at shell prompt)"
      print -r -- "── $name: $state"
      t capture-pane -p -J -t "$(target "$name")" -S -15 | grep -v '^[[:space:]]*$' | tail -8 | sed 's/^/   /'
    done
    (( found )) || print "no worker agents in session '$SESSION'" ;;

  artifact)
    [[ -n "$1" ]] || die "usage: tmux-ctl artifact <path> [--kind plan|spec|handoff|report|other]"
    p="${1:A}"; shift; k=""; kopt=()
    [[ "$1" == --kind && -n "$2" ]] && { k="$2"; kopt=(--kind "$k") }
    [[ -f "$p" ]] || die "no file '$p'"
    warn_web_key
    # no --kind: the hook's kind_of() decides (plan, spec, handoff, report), else "other"
    "${0:A:h:h}/claude/hooks/artifact-register.sh" --path "$p" "${kopt[@]}" --project "$FEEDKEY"
    k="$(jq -r --arg p "$p" 'select(.path==$p and .kind)|.kind' "$STATE/artifacts-$FEEDKEY.jsonl" 2>/dev/null | tail -1)"
    print -r -- "registered $p (${k:-unknown})" ;;

  idea)
    if [[ "$1" == --done ]]; then
      [[ -n "$2" && "$3" == --spec && -n "$4" ]] || die 'usage: tmux-ctl idea --done "<text>" --spec <path>'
      python3 -I "${0:A:h:h}/board/ideas.py" add-done --project "$FEEDKEY" --spec "$4" -- "$2"
    else
      [[ -n "$*" ]] || die "usage: tmux-ctl idea <text>"
      python3 -I "${0:A:h:h}/board/ideas.py" add --project "$FEEDKEY" -- "$*"
    fi ;;

  context)
    sub="$1"; [[ -n "$sub" ]] && shift
    case "$sub" in
      show|path) python3 -I "${0:A:h:h}/board/context.py" "$sub" --project "$FEEDKEY" ;;
      add)
        [[ -n "$1" && -n "$2" ]] || die 'usage: tmux-ctl context add <Map|How to run|Gotchas|Decisions> "<entry>"'
        sec="$1"; shift
        python3 -I "${0:A:h:h}/board/context.py" add --project "$FEEDKEY" --section "$sec" -- "$*" ;;
      search)
        [[ -n "$1" ]] || die 'usage: tmux-ctl context search <words…>'
        python3 -I "${0:A:h:h}/board/context.py" search --project "$FEEDKEY" -- "$@" ;;
      *) die 'usage: tmux-ctl context show | path | add <section> "<entry>" | search <words…>' ;;
    esac ;;

  awake)
    source "${0:A:h:h}/tools/lib/awake.zsh"
    awake_cmd "$@"; exit $? ;;

  wait-gone)   # spec 2026-11-10-queue-reliability §1: the lead never ends a turn waiting for shutdown confirmations
    wg_usage="usage: tmux-ctl wait-gone <name>... [--timeout <s>]"
    wg_names=(); wg_to=300
    while (( $# )); do
      if [[ "$1" == --timeout ]]; then
        [[ "$2" == <-> ]] || die "$wg_usage"
        wg_to="$2"; shift 2
      else wg_names+=("${1#✦ }"); shift; fi
    done
    (( $#wg_names )) || die "$wg_usage"
    zmodload zsh/datetime
    wg_start=$EPOCHSECONDS
    while :; do
      # exact names only, and the window id for the kill: a `-t "=sess:✦ a"` target also matches `✦ a-2` by prefix when `✦ a` is gone
      # a failed listing is not "no windows": nothing is read from it, and the names stay unconfirmed until a listing succeeds
      typeset -A wg_ids=()
      wg_raw="$(t list-windows -t "=$SESSION" -F '#{window_id} #{window_name}' 2>/dev/null)" && wg_listed=1 || wg_listed=0
      if (( wg_listed )); then
        for wg_l in ${(f)wg_raw}; do
          wg_ids[${wg_l#* }]="${wg_l%% *}"
        done
        wg_left=()
        for wg_n in $wg_names; do (( ${+wg_ids[✦ $wg_n]} )) && wg_left+=("$wg_n"); done
        if (( ! $#wg_left )); then wg_clear "${wg_names[@]}"; print -r -- "wait-gone: all gone"; exit 0; fi
      fi
      (( EPOCHSECONDS - wg_start >= wg_to )) && break
      sleep $(( wg_to - (EPOCHSECONDS - wg_start) < 2 ? wg_to - (EPOCHSECONDS - wg_start) : 2 ))
    done
    if (( ! wg_listed )); then
      for wg_n in $wg_names; do print -r -- "wait-gone: could not kill $wg_n"; done
      exit 3
    fi
    wg_done=("${(@)wg_names:|wg_left}")   # the names that were already gone, plus each one killed below
    for wg_n in $wg_left; do
      if t kill-window -t "${wg_ids[✦ $wg_n]}" 2>/dev/null; then wg_done+=("$wg_n"); else print -r -- "wait-gone: could not kill $wg_n"; fi
    done
    wg_clear "${wg_done[@]}"
    print -r -- "wait-gone: killed ${(j: :)wg_left} after ${wg_to}s"
    exit 3 ;;

  handoff-mark)   # spec 2026-11-10-queue-reliability §3: read by claude/plugin/scripts/lead-stop-guard.sh
    [[ $# -eq 0 || ( $# -eq 1 && "$1" == --clear ) ]] || die "usage: tmux-ctl handoff-mark [--clear]"
    [[ "$CLAUDE_CODE_SESSION_ID" =~ '^[A-Za-z0-9_-]+$' ]] || die "handoff-mark needs CLAUDE_CODE_SESSION_ID (run it from the lead's own Bash tool)"
    hm="$STATE/handoff-pending/$CLAUDE_CODE_SESSION_ID"
    if [[ "$1" == --clear ]]; then rm -f -- "$hm"; print -r -- "handoff-mark: cleared"
    else mkdir -p "${hm:h}" && : > "$hm" || die "cannot write $hm"; print -r -- "handoff-mark: set"; fi ;;

  relay)
    [[ -n "$1" ]] || die "usage: tmux-ctl relay <handoff-doc> [--old-session <id>]"
    doc="${1:A}"; shift; old=""
    [[ "$1" == --old-session && -n "$2" ]] && old="$2"
    [[ -f "$doc" ]] || die "no handoff doc '$doc'"
    warn_web_key
    # lead-only: relay.py respawns the session's claude window as the lead. Called from a worker, teammate, lane or
    # shell window it must leave the lead alone and hand the user the manual start instead.
    # R7: the lead is AGENT_BOARD_LEAD=1, in a window named claude (or claude-next, renamed below), in this session, not a teammate
    cwin=; csess=; cmate=; creal=
    [[ -n "$TMUX_PANE" ]] && { creal="$(t display -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)"; cwin="$(t display -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null)"; csess="$(t display -p -t "$TMUX_PANE" '#{?session_group,#{session_group},#{session_name}}' 2>/dev/null)"; cmate="$(t display -p -t "$TMUX_PANE" '#{@tc_teammate}' 2>/dev/null)"; }
    if [[ "$AGENT_BOARD_LEAD" != 1 || ( "$cwin" != claude && "$cwin" != claude-next ) || "$csess" != "$FEEDKEY" || -n "$cmate" && "$cmate" != 0 ]]; then
      print -u2 -r -- "tmux-ctl: relay refused: only the lead, from the session's claude window, can relay (this is ${cwin:-no tmux pane}). The lead was not touched. Give the user this to start the new lead by hand: ${(q)TC_REPO}/bin/claude-orchestrator 'Read $doc and continue from where the previous session left off.'"
      exit 2
    fi
    if [[ "$cwin" == claude-next ]]; then   # relay.py finds the lead by the window name claude: rename only after every check passed
      t list-windows -t "=$creal:" -F '#{window_name}' | grep -qx claude && { print -u2 -r -- "relay: a claude window already exists in $creal"; exit 2; }
      t rename-window -t "$TMUX_PANE" claude || die "cannot rename the claude-next window"
    fi
    log="$STATE/relay-$FEEDKEY.log"
    sock="$(t display -p '#{socket_path}')"
    # detached: the lead that asked for the relay must finish its turn before its pane is replaced
    # tmux format-expands run-shell strings: '#' -> '##' in every interpolated argument
    h() { print -r -- "${1//\#/##}" }
    t run-shell -b "python3 -I $(h ${(q)${0:A:h:h}})/board/relay.py --session $(h ${(q)FEEDKEY}) --doc $(h ${(q)doc}) --old-session $(h ${(q)old}) --state $(h ${(q)STATE}) --socket $(h ${(q)sock}) > $(h ${(q)log}) 2>&1 || $(h ${(q)${0:A}}) _relay_failed $(h ${(q)log}) $(h ${(q)doc}) $(h ${(q)FEEDKEY})"
    # the relay is scheduled: the self-started handoff's mark (handoff-mark) has done its job. Remove the old session's and
    # the caller's own, so a wrong or missing --old-session never leaves the Stop guard blocking the stop the relay waits for.
    for hm in "$old" "$CLAUDE_CODE_SESSION_ID"; do
      [[ "$hm" =~ '^[A-Za-z0-9_-]+$' ]] && rm -f -- "$STATE/handoff-pending/$hm"
    done
    print -r -- "relay scheduled: ${FEEDKEY}:claude restarts with $doc once this turn ends (log: $log)" ;;

  lead-restart)   # spec 2026-11-19-lead-recovery §2: works outside tmux (a Discord /lead, discord-watch)
    lr_usage="usage: tmux-ctl lead-restart <project> [--resume | --doc <handoff>]"
    [[ -n "$1" && "$1" != -* ]] || die "$lr_usage"
    lr_proj="$1"; shift; lr_args=(); lr_resume=0; lr_doc=0
    while (( $# )); do
      case "$1" in
        --resume) lr_resume=1; lr_args+=(--resume); shift ;;
        --doc) [[ -n "$2" ]] || die "$lr_usage"; lr_doc=1; lr_args+=(--doc "${2:A}"); shift 2 ;;
        *) die "$lr_usage" ;;
      esac
    done
    (( lr_resume && lr_doc )) && { print -u2 -r -- "lead-restart: --resume and --doc exclude each other. $lr_usage"; exit 2; }
    lr_sock="$(t display -p '#{socket_path}' 2>/dev/null)"; [[ -n "$lr_sock" ]] && lr_args+=(--socket "$lr_sock")
    lr_out="$(python3 -I "${0:A:h:h}/board/relay.py" lead-restart "$lr_proj" "${lr_args[@]}")" || exit $?
    lr_pane="${${(f)lr_out}[2]#pane }"
    # the bot: the new lead's own MCP server takes a moment to claim the channel
    source "${0:A:h:h}/tools/lib/discord.zsh"
    lr_dir="$(_dc_root)/$lr_proj"; lr_bot="no bot"
    if "$_DC_TOOLS/../claude/plugin/scripts/discord-mcp-launch" --has-token "$lr_dir" 2>/dev/null; then
      lr_bot="not held"; lr_n="${LEAD_RESTART_BOT_WAIT:-20}"
      while :; do
        lr_hold="$(dc_holder "$lr_dir")"
        [[ -n "$lr_hold" && "${lr_hold#* }" == "$lr_pane" ]] && { lr_bot="held by the new lead"; break }
        (( lr_n-- > 0 )) || break
        sleep 1
      done
    fi
    print -r -- "${${(f)lr_out}[1]}; bot: $lr_bot" ;;

  overview)
    proj=""; jflag=()
    for a in "$@"; do
      if [[ "$a" == --json ]]; then jflag=(--json)
      elif [[ -z "$proj" && "$a" != -* ]]; then proj="$a"
      else die "usage: tmux-ctl overview [project] [--json]"; fi
    done
    popt=(); [[ -n "$proj" ]] && popt=(--project "$proj")
    exec python3 -I "${0:A:h:h}/board/overview.py" "${popt[@]}" "${jflag[@]}" ;;

  metrics)
    exec python3 -I "${0:A:h:h}/board/metrics.py" "$@" ;;

  ""|-h|--help|help)
    sed -n '2,84p' "$0" | sed 's/^# \{0,1\}//' ;;

  *) die "unknown command '$cmd' (tmux-ctl help)" ;;
esac
