#!/usr/bin/env zsh
# claude-config-link [--dry-run] — symlink the tracked claude/ config into ~/.claude.
# Per path: absent -> link; regular file/dir -> back up to ~/.claude/backups/config-link-YYYYMMDD/<path under ~/.claude>
# (or .2, .3 … if taken, never overwritten), then link. Never beside the item: a skills/<name>.bak-* dir is loaded as a skill;
# link to this repo -> leave; link elsewhere -> refuse (exit 1, other paths still processed).
# settings.json is never linked (Claude Code writes it); use claude-config-sync.
emulate -L zsh
repo="${0:A:h:h}"; src="$repo/claude"; live="$HOME/.claude"
# The live install points at the main checkout (see CLAUDE.md), even when this script runs from a worktree.
gc="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && main="${gc:h}" || main="$repo"
dry=0; [[ "$1" == --dry-run ]] && dry=1
stamp="$(date +%Y%m%d)"; rc=0

free_backup() {   # first unused backups/config-link-DATE/<rel>, then <rel>.2, …  (-e || -L: a dangling link also holds a name)
  local b="$live/backups/config-link-$stamp/${1#$live/}" n=2 base
  base="$b"
  while [[ -e "$b" || -L "$b" ]]; do b="$base.$n"; (( n++ )); done
  print -r -- "$b"
}

link_one() {   # link_one <repo file/dir> <live path>
  local from="$1" to="$2" cur bak
  if [[ -L "$to" ]]; then
    cur="$(readlink "$to")"
    if [[ "$cur" == "$from" ]]; then print -r -- "ok      $to"; return; fi
    print -ru2 -- "REFUSE  $to is a link to $cur, not $from (if intended, remove it and rerun)"; rc=1; return
  fi
  if [[ -e "$to" ]]; then
    bak="$(free_backup "$to")"
    if (( dry )); then print -r -- "would backup $to -> $bak"; else mkdir -p "${bak:h}" && mv -n "$to" "$bak" && print -r -- "backup  $to -> $bak" || { print -ru2 -- "REFUSE  could not back up $to"; rc=1; return; }; fi
  fi
  if (( dry )); then print -r -- "would link   $to -> $from"
  else mkdir -p "${to:h}" && ln -s "$from" "$to" && print -r -- "link    $to -> $from"; fi
}

local e f name
for e in "$src"/*(N); do
  name="${e:t}"; e="$main/claude/$name"   # link target in the main checkout; names come from this tree
  if [[ "$name" == (hooks|agents|skills) && -L "$live/$name" ]]; then
    print -ru2 -- "REFUSE  $live/$name is itself a symlink; links would be written through it (replace it with a real directory)"; rc=1; continue
  fi
  case "$name" in
    settings.json) print -r -- "skip    $live/settings.json (regular file; use claude-config-sync)" ;;
    hooks|agents)  for f in "$src/$name"/*(N); do link_one "$main/claude/$name/${f:t}" "$live/$name/${f:t}"; done ;;
    skills)        for f in "$src/$name"/*(N/); do link_one "$main/claude/$name/${f:t}" "$live/skills/${f:t}"; done ;;
    *)             link_one "$e" "$live/$name" ;;
  esac
done
exit $rc
