#!/usr/bin/env zsh
# tmux-dash — localhost dashboard for tmux + Claude agent teams, with live terminals.
#
#   tmux-dash            start (if needed) and open in the browser
#   tmux-dash url        print the dashboard URL
#   tmux-dash stop       stop the dashboard + terminal server
#   tmux-dash status     show whether it's running
#   tmux-dash rotate     new secret token (old URLs stop working), then restart
#
# Everything listens on 127.0.0.1 only and needs the secret token in the URL.
emulate -L zsh
source "${0:A:h}/_tc_bins.zsh"
tc_tmux_resolve dedicated                           # the board shows agent-board's own server, wherever tmux-dash was typed
export TMUX_DASH_TMUX_ARGS="$(tc_tmux_args_str)"   # server.py and ttyd's tmux-web-attach read the same server
STATE="$HOME/.local/state/tmux-dash"
APP="${0:A:h:h}/board"
PORT="${TMUX_DASH_PORT:-7700}"
TTYD_PORT="${TMUX_DASH_TTYD_PORT:-7701}"
mkdir -p "$STATE"; chmod 700 "$STATE"

token() {
  [[ -s "$STATE/token" ]] || { python3 -c 'import secrets; print(secrets.token_urlsafe(24))' > "$STATE/token"; chmod 600 "$STATE/token" }
  <"$STATE/token"
}
url() { print -r -- "http://127.0.0.1:$PORT/$(token)/" }
alive() { [[ -s "$STATE/$1.pid" ]] && kill -0 "$(<"$STATE/$1.pid")" 2>/dev/null }

stop() {
  for p in server ttyd; do
    alive $p && kill "$(<"$STATE/$p.pid")" 2>/dev/null
    rm -f "$STATE/$p.pid"
  done
}

start() {
  local tok; tok="$(token)"
  if ! alive ttyd; then
    TMUX_DASH_TMUX_ARGS="$TMUX_DASH_TMUX_ARGS" nohup "$(tc_bin ttyd TTYD_BIN)" \
      -i 127.0.0.1 -p "$TTYD_PORT" -b "/$tok-tty" -O -W -a \
      -t fontSize=13 -t 'fontFamily=SF Mono, Menlo, monospace' -t disableLeaveAlert=true \
      -t 'theme={"background":"#1e1e2e","foreground":"#cdd6f4","cursor":"#f5e0dc","selectionBackground":"#45475a"}' \
      "${0:A:h}/tmux-web-attach" > "$STATE/ttyd.log" 2>&1 &
    print $! > "$STATE/ttyd.pid"
  fi
  if ! alive server; then
    TMUX_DASH_TOKEN="$tok" TMUX_DASH_PORT="$PORT" TMUX_DASH_TTYD_PORT="$TTYD_PORT" \
      nohup python3 "$APP/server.py" > "$STATE/server.log" 2>&1 &
    print $! > "$STATE/server.pid"
  fi
  sleep 0.7
  alive server && alive ttyd || { print -u2 "tmux-dash: failed to start — see $STATE/*.log"; stop; exit 1 }
}

case "${1:-open}" in
  open)   start; url
          if (( $+commands[open] )); then open "$(url)"
          elif (( $+commands[xdg-open] )); then xdg-open "$(url)" >/dev/null 2>&1
          fi ;;
  start)  start; url ;;
  url)    url ;;
  stop)   stop; print "stopped" ;;
  status) for p in server ttyd; do alive $p && print "$p: running (pid $(<"$STATE/$p.pid"))" || print "$p: stopped"; done ;;
  rotate) stop; rm -f "$STATE/token"; start; url ;;
  *)      sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
